rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Regra para perfis de usuários em users/{uid}
    // Apenas o próprio usuário autenticado pode ler e gravar seu documento de perfil
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null && request.auth.uid == userId;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Preparação para futura coleção de pacotes públicos (bloqueado por padrão)
    match /public_packs/{packId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == request.resource.data.authorUid;
    }

    // Nega acesso a qualquer outro caminho por padrão
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
