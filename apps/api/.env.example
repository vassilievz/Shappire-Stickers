# ============================================================
# Shappire API - Environment Variables (apps/api)
# ============================================================
# Copie para .env e preencha com valores reais.
# NUNCA comite o .env. NUNCA versione credenciais.

# Porta HTTP da API
PORT=8080

# MongoDB — a URI PRECISA terminar explicitamente com o nome do banco:
# mongodb+srv://USUARIO:SENHA@cluster.mongodb.net/shappirestickers?retryWrites=true&w=majority
MONGODB_URI=

# Chave secreta da API V0X (prefixo v0x_live_). Fica SOMENTE aqui.
V0X_API=

# Credenciais do Firebase Admin (Conta de serviço — NUNCA no app/APK/Git)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Origens CORS permitidas, separadas por vírgula (produção NUNCA usa *)
# App Capacitor Android: https://localhost (androidScheme https)
CORS_ORIGIN=

# Elegibilidade +18 por autoatribuição (apenas dev/staging). Em produção deixe desligado
# até existir verificação de idade adequada.
# ADULT_CONTENT_SELF_ATTESTATION=false

# Sincronizar índices Mongoose na subida (idempotente). Desligue com SYNC_MONGOOSE_INDEXES=false
# se precisar evitar trabalho de índice em deploy sensível.

# DNS explícito do ambiente de execução (§8) — separados por vírgula.
# Use quando o resolvedor do host falhar nas consultas SRV do MongoDB
# (ex.: proxy DNS local). NUNCA coloque estes valores dentro da MONGODB_URI.
# DNS_SERVERS=8.8.8.8,8.8.4.4

# development | production
NODE_ENV=development

# Defina true quando a API rodar atrás de proxy/reverse proxy (X-Forwarded-For)
TRUST_PROXY=false

# GoatPay (PIX) — somente no servidor (Railway, etc.)
# GOAT_API_KEY=

# Concede insígnia Apoiador Inicial em pagamentos qualificados do Doador Mensal durante o beta
# DONOR_BETA_BADGE_ENABLED=true
