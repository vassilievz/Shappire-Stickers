{
  "name": "shappire-stickers",
  "private": true,
  "version": "0.2.1",
  "description": "Monorepo Shappire Stickers: app Android (apps/app), API (apps/api) e contratos compartilhados (packages/contracts)",
  "license": "MIT",
  "author": "Gabriel (vassiliev)",
  "homepage": "https://github.com/vassilievz/Shappire-Stickers",
  "repository": {
    "type": "git",
    "url": "https://github.com/vassilievz/Shappire-Stickers.git"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "node apps/api/src/server.js",
    "api:dev": "npm run dev -w apps/api",
    "app:dev": "npm run dev -w apps/app",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "build": "npm run build -w apps/app",
    "cap:sync": "npm run cap:sync -w apps/app",
    "android:debug": "npm run android:debug -w apps/app"
  }
}
