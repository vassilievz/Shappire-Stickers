{
  "name": "shappire-stickers",
  "private": true,
  "version": "0.2.0",
  "description": "Shappire Stickers - app Android (React + Capacitor) para criar figurinhas do WhatsApp",
  "type": "module",
  "license": "MIT",
  "author": "Gabriel (vassiliev)",
  "homepage": "https://github.com/vassilievz/Shappire-Stickers",
  "repository": {
    "type": "git",
    "url": "https://github.com/vassilievz/Shappire-Stickers.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "cap:sync": "npm run build && cap sync android",
    "cap:copy": "npm run build && cap copy android",
    "cap:open": "cap open android",
    "android:debug": "npm run cap:sync && cd android && ./gradlew assembleDebug --console=plain"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/camera": "^8.2.5",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@otakit/capacitor-updater": "^3.2.0",
    "jszip": "^3.10.2",
    "konva": "^10.7.0",
    "lucide-react": "^1.51.0",
    "omggif": "^1.0.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-konva": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/jszip": "^3.4.0",
    "@types/node": "^26.6.4",
    "@types/omggif": "^1.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^27.4.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
